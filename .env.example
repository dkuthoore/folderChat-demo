GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5-nano-2025-08-07
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=86400 # 24 hours

# Storage backend selection
# Use "local" for development before Replit Postgres is configured.
# Swap to "pgvector" when your Replit database is ready.
VECTOR_STORE_BACKEND=local

# Local development storage paths
LOCAL_STORAGE_DIR=./data/storage
LOCAL_UPLOADS_DIR=./data/uploads

# Future Replit Postgres / pgvector settings
DATABASE_URL=postgresql://username:password@host:5432/database_name
PGVECTOR_TABLE_NAME=document_chunks
